# FitGiriş Environment Configuration

# Application Environment
ENVIRONMENT=development
PORT=8080

# Database Configuration (PostgreSQL 16)
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=fitgiris
DB_PORT=5432
DATABASE_URL=postgres://postgres:postgres@postgres:5432/fitgiris?sslmode=disable

# Security / JWT
JWT_SECRET=fitgiris-super-secret-key-change-in-production-32chars

# Simulator Configuration
SIMULATOR_SEED=42
SIMULATOR_BRANCHES=5
SIMULATOR_MEMBERS=20000
